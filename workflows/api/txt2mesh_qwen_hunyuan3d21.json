    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_2512_fp8_e4m3fn.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Qwen Diffusion"
    }
  },
  "2": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift": 3.1
    },
    "_meta": {
      "title": "Sampling Shift"
    }
  },
  "3": {
