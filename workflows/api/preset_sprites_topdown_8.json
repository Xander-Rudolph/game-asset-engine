{
  "_comment": "DROP-IN PRESET: 8 facings for a top-down or three-quarter overhead game. Elevation 60 suits a 4:3-ish overhead view; for a true straight-down camera use scripts/render_sheet.py --elevation 90. Azimuths start at 0 because a top-down camera looks along the world axes rather than between them, which is the opposite of the isometric case. Generated by scripts/build_presets.py.",
  "1": {
    "class_type": "[Comfy3D] Load 3D Mesh",
    "inputs": {
      "mesh_file_path": "/app/output/mesh/asset.glb",
      "resize": true,
      "renormal": true,
      "retex": false,
      "optimizable": false,
      "clean": false,
      "resize_bound": 0.9
    },
    "_meta": {
      "title": "Load Mesh"
    }
  },
  "2": {
    "class_type": "[Comfy3D] Stack Orbit Camera Poses",
    "inputs": {
      "orbit_radius_start": 1.75,
      "orbit_radius_stop": 1.75,
      "orbit_radius_step": 0.1,
      "elevation_start": 60.0,
      "elevation_stop": 60.0,
      "elevation_step": 0.0,
      "azimuth_start": 0.0,
      "azimuth_stop": 315.0,
      "azimuth_step": 45.0,
      "orbit_center_X_start": 0.0,
      "orbit_center_X_stop": 0.0,
      "orbit_center_X_step": 0.1,
      "orbit_center_Y_start": 0.0,
      "orbit_center_Y_stop": 0.0,
      "orbit_center_Y_step": 0.1,
      "orbit_center_Z_start": 0.0,
      "orbit_center_Z_stop": 0.0,
      "orbit_center_Z_step": 0.1
    },
    "_meta": {
      "title": "Camera Poses"
    }
  },
  "3": {
    "class_type": "[Comfy3D] Mesh Orbit Renderer",
    "inputs": {
      "mesh": [
        "1",
        0
      ],
      "render_orbit_camera_poses": [
        "2",
        0
      ],
      "render_image_width": 512,
      "render_image_height": 512,
      "render_orbit_camera_fovy": 49.1,
      "render_background_color_r": 0.0,
      "render_background_color_g": 0.0,
      "render_background_color_b": 0.0,
      "force_cuda_rasterize": false,
      "render_depth": false,
      "render_normal": false
    },
    "_meta": {
      "title": "Orbit Render"
    }
  },
  "4": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "3",
        0
      ],
      "filename_prefix": "sprites/topdown"
    },
    "_meta": {
      "title": "Save Sprites"
    }
  },
  "5": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": [
        "3",
        1
      ]
    },
    "_meta": {
      "title": "Mask to Image"
    }
  },
  "6": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "5",
        0
      ],
      "filename_prefix": "sprites/asset_mask"
    },
    "_meta": {
      "title": "Save Masks"
    }
  }
}
