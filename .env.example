# Copy to .env and adjust. Every value here is host-specific — nothing in this
# file is a secret, but nothing in it is portable either.

# Where model weights live. Resolved by docker compose RELATIVE TO THIS
# DIRECTORY, the way compose resolves any relative bind mount — so
# `../../models/` from /lordsofmagic/model_workflows means /models.
# An absolute path is clearer if you have one. Expect ~140GB with every group
# fetched; `scripts/fetch_models.py --all` reports the exact figure first.
#
# Everything weight-shaped goes here, including ComfyUI-3D-Pack's own
# Checkpoints tree: compose mounts ${MODELS_DIR}/3d_checkpoints over it, because
# the pack hardcodes that path inside its node directory.
MODELS_DIR=../../models/

# The uid/gid the container runs as. Set these to your own (`id -u`, `id -g`)
# or every generated mesh, sprite and sheet lands in output/ owned by root and
# you cannot move it into the game without sudo.
PUID=1000
PGID=1000

# Optional. Needed only for the `gated` model group (StableFast3D): accept the
# licence on the model's Hugging Face page first, then paste a read token.
# scripts/fetch_models.py picks this up from the environment too.
#HF_TOKEN=

# Optional. Where scripts/run_workflow.py and validate_workflows.py look for
# ComfyUI. Only change this if you moved the port in docker-compose.yml.
#COMFY_URL=http://127.0.0.1:8188
