{
  "_comment": [
    "Model dependency manifest for scripts/fetch_models.py.",
    "",
    "Paths in 'dest' are relative to MODELS_DIR (see .env).  Two kinds:",
    "  file     - one file from a HF repo, saved at dest",
    "  snapshot - a whole HF repo (or a subtree of it) mirrored under dest",
    "",
    "'3d_checkpoints/...' is what the container mounts over ComfyUI-3D-Pack's",
    "own Checkpoints folder, so those paths must match what the nodes expect:",
    "  Checkpoints/<Name>            for the *_ckpt_name loaders",
    "  Checkpoints/Diffusers/<repo>  for the diffusers pipelines",
    "",
    "groups: 'core' is fetched by default.  Everything else is opt-in with",
    "--group NAME, or --all for the lot.  'gated' needs HF_TOKEN.",
    "",
    "Every entry carries 'license', 'license_url' and 'commercial'. `fetch_models.py --licenses` prints them, and --download refuses a non-commercial model unless you pass --accept-noncommercial."
  ],
  "groups": {
    "core": "SDXL image generation + TripoSR/TripoSG image-to-3D",
    "hunyuan": "Hunyuan3D 2.1 shape generation (best mesh quality, ~10GB)",
    "instantmesh": "Zero123++ multiview -> InstantMesh reconstruction",
    "trellis": "TRELLIS image-to-3D: both branches, ~9.6GB",
    "mvadapter": "MV-Adapter multiview / texturing on top of SDXL",
    "unique3d": "Unique3D + CharacterGen chain (SD1.5, IP-Adapter, ControlNet tile, RealESRGAN)",
    "extra": "LGM, CRM, TriplaneGaussian, PartCrafter",
    "gated": "StableFast3D - accept the licence on HF and set HF_TOKEN",
    "noncommercial": "Models whose licence forbids commercial use - never fetched by --all",
    "qwen": "Qwen-Image text-to-image - Apache-2.0, far better prompt adherence than SDXL base",
    "qwen_edit": "Qwen-Image-Edit 2509 - change one element of a concept without rerolling it"
  },
